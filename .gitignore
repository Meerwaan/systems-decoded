# ===================================================
# ULTRA-STRICT GITIGNORE - MOTION DESIGN & HYPERFRAME
# Empêche le dépôt d'être pollué par les fichiers lourds,
# les rendus, les caches et les fichiers temporaires.
# ===================================================

# ---------------------------------------------------
# 1. RENDUS & EXPORTS (Hyperframe, Remotion, Ae, etc.)
# ---------------------------------------------------
renders/
render/
output/
outputs/
exports/
export/
episodes/*/renders/
episodes/*/output/
episodes/*/exports/
kit/*/dist/
kit/*/build/
compositions/**/*.mp4
compositions/**/*.mov
compositions/**/*.MOV
compositions/**/*.webm
compositions/**/*.exr

# ---------------------------------------------------
# 2. FICHIERS MÉDIA LOURDS & RUSHES (Vidéo / Audio / 3D)
# ---------------------------------------------------
# Vidéos
*.mp4
*.mov
*.MOV
*.webm
*.avi
*.m4v
*.mkv
*.flv
*.wmv
*.prores

# Audio brut & Voix off
*.wav
*.mp3
*.aac
*.flac
*.ogg
*.m4a
audio/raw/
footage/
raw/
raw_assets/
recordings/
screen-recordings/
voiceovers/

# Textures lourdes & Séquences d'images (EXR, HDR, TIF)
*.exr
*.hdr
*.hdri
*.tif
*.tiff
*.tga
*.dpx

# ---------------------------------------------------
# 3. FICHIERS TEMPORAIRES DESIGN & 3D (Ae, C4D, Blender)
# ---------------------------------------------------
*.autosave
*.blend1
*.blend2
*.blend3
*.c4d.bak
*.aep.bak
*.aepx.bak
Adobe After Effects Cache/
"Ae Cache/"
"after_effects_cache/"
*.tmp
*.bak

# ---------------------------------------------------
# 4. DÉPENDANCES & BUILDS (Node, esbuild, hyperframe)
# ---------------------------------------------------
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
dist/
build/
.out/
.esbuild/
*.tsbuildinfo

# ---------------------------------------------------
# 5. CACHES & FICHIERS TEMPORAIRES DE DÉVELOPPEMENT
# ---------------------------------------------------
.tmp/
tmp/
.cache/
.hyperframe/
.hyperframes/
.remotion/
.turbo/
.next/
.debug/

# ---------------------------------------------------
# 6. ENVIRONNEMENT & SECRETS (Clés API, mdp)
# ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------------------------------------------------
# 7. ARCHIVES & FICHIERS COMPRESSÉS
# ---------------------------------------------------
*.zip
*.tar
*.gz
*.tgz
*.rar
*.7z
*.iso
*.dmg

# ---------------------------------------------------
# 8. LOGS & JOURNAUX
# ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------
# 9. SYSTÈME & ÉDITEURS (macOS, Windows, VS Code, JetBrains)
# ---------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Dd]esktop.ini
Thumbs.db
$RECYCLE.BIN/

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.user

# 10. Systems Decoded — fichiers générés (reconstruits par `npm run build` / `npm run sfx`)
episodes/*/gen/
episodes/*/snapshots/
episodes/*/audio/takes/
episodes/*/audio/bed.wav
